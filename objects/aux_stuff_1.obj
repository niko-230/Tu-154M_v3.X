# aux_stuff_1.png (2048x1024): left half = M donor aux_stuff.png, right half = soft intake covers + numbers
# intake covers follow the EFB ground equipment choice: CIVIL (hide_civ = 0) -> soft covers, VVS / DEF -> hard covers
ANIM_begin
ANIM_hide 0.000000 0.000000 tu154b2/custom/anim/engine_caps
ATTR_shiny_rat 0.500000
# exhaust caps (always)
TRIS 0 3744
# hard intake caps - hidden when CIVIL ground equipment is selected
ANIM_begin
ANIM_hide -0.500000 0.500000 sim/custom/t154cfg/hide_civ
TRIS 3744 1344
ATTR_reset
TRIS 5088 7584
ANIM_end
ATTR_reset
# soft intake caps (engines 1, 3, 2) + numbers "1" (engine 1) and "3" (engine 3) - only with CIVIL ground equipment
ANIM_begin
ANIM_hide 0.500000 1.500000 sim/custom/t154cfg/hide_civ
TRIS 28476 31968
ATTR_poly_os 2.000000
TRIS 60444 768
ATTR_poly_os 0.000000
ANIM_end
ANIM_end
